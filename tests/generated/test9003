<testcase>
<info>
<keywords>
HSTS
HTTP
</keywords>
</info>

#
# Client-side
<client>
<features>
!http
</features>
<name>
--hsts is silently unsupported when HTTP is not built in (C4)
</name>
<command>
--hsts %LOGDIR/hsts9003.txt http://test.example.com/
</command>
</client>

#
# Verify data after the test has been "shot"
<verify>
<errorcode>
2
</errorcode>
<stderr mode="text">
curl: option --hsts: the installed libcurl version does not support this
curl: try 'curl --help' or 'curl --manual' for more information
</stderr>
</verify>
</testcase>
