<testcase>
<info>
<keywords>
alt-svc
HTTP
</keywords>
</info>

#
# Client-side
<client>
<features>
!http
</features>
<name>
--alt-svc is silently unsupported when HTTP is not built in (C5)
</name>
<command>
--alt-svc %LOGDIR/altsvc9004.txt http://test.example.com/
</command>
</client>

#
# Verify data after the test has been "shot"
<verify>
<errorcode>
2
</errorcode>
<stderr mode="text">
curl: option --alt-svc: the installed libcurl version does not support this
curl: try 'curl --help' or 'curl --manual' for more information
</stderr>
</verify>
</testcase>
